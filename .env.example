# Configuration Supabase
# Copier ce fichier vers .env.local et renseigner les valeurs du projet.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Connexion par code SMS : laisser à false tant que le fournisseur SMS
# n'est pas configuré dans Supabase (Auth → Providers → Phone).
VITE_AUTH_SMS=false
